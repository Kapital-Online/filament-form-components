{
    "name": "kapital-online/filament-form-components",
    "description": "Enhanced Filament form components with extended functionality for multiple select, disabled options, and more",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kapital Online",
            "email": "dev@ko.com.tr"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/forms": "^4.0",
        "filament/tables": "^4.0",
        "illuminate/support": "^11.28"
    },
    "autoload": {
        "psr-4": {
            "Kapital\\Filament\\FormComponents\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kapital\\Filament\\FormComponents\\FilamentFormComponentsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-codex/filament-4": "3.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "Kapital\\Filament\\FormComponents\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.33"
        }
    }
}
